# ======================================================
# Variáveis de Configuração Essenciais
# ======================================================

# 1. CAMINHO ABSOLUTO DO HOST PARA A PASTA DO PROJETO
# 
# MUITO IMPORTANTE:
# Este deve ser o caminho COMPLETO e REAL no seu sistema operacional (HOST)
# onde o seu docker-compose.yml e bot.py estão localizados.
# 
# Use 'pwd' ou 'echo $HOME/caminho/do/seu/bot' no terminal do host para encontrar.
#
# Exemplos:
# HOST_PROJECT_PATH_ABSOLUTE=/home/seunome/bots/userlixo
# HOST_PROJECT_PATH_ABSOLUTE=C:/Users/SeuNome/Desktop/userlixo 
HOST_PROJECT_PATH_ABSOLUTE=

# 2. CREDENCIAIS DO TELEGRAM
# Seu ID de API e Hash fornecidos pelo my.telegram.org
# Coloque seu id aqui (sem aspas)
API_ID=
# Coloque sua hash aqui (sem aspas)
API_HASH=
